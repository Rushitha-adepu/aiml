
from itertools import permutations

def tsp(graph, start):
    n = len(graph)
    cities = list(range(n))
    cities.remove(start)

    min_cost = float('inf')
    best_route = []

    for route in permutations(cities):
        current_path = [start] + list(route) + [start]
        current_cost = 0
        valid = True

        for i in range(len(current_path) - 1):
            u = current_path[i]
            v = current_path[i + 1]

            if graph[u][v] == 0 and u != v:
                valid = False
                break

            current_cost += graph[u][v]

        if valid and current_cost < min_cost:
            min_cost = current_cost
            best_route = current_path

    print("Best Route:", best_route)
    print("Minimum Cost:", min_cost)


# Test case: small complete graph
graph = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]

tsp(graph, 0)

